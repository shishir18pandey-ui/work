    },
    {
      "name": "mutual_fund_holdings_check",
      "type": "JAEGER",
      "purpose": "Check Mutual Fund holdings traces when customer is unable to view investment details.",
      "service": "WEALTH-API",
      "parameters": [
        {"name": "tag_name", "type": "string", "description": "Identifier type: customer_id or ucic", "required": true},
        {"name": "tag_value", "type": "string", "description": "The actual identifier value", "required": true}
      ],
      "output_description": "Returns Mutual Fund holdings traces and downstream errors, if any.",
      "example_use_cases": ["Unable to view mutual fund holdings", "Investment details not loading", "Mutual fund portfolio unavailable"],
      "app_tags": ["optimus", "wealth", "mutual-fund", "investment"]
