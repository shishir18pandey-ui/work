    async def _decide_next_action(
        self,
        context: str,
        tool_calls: List[Dict],
        iteration: int
    ) -> Dict:
        history_text = ""
        if tool_calls:
            history_text = "\n\n=== PREVIOUS TOOL CALLS ===\n"
            for call in tool_calls:
                history_text += f"\n- Tool: {call['tool_name']}\n  Input: {call['input_params']}\n  Output: {call['output'][:500]}...\n"
        
        # Add error chain to context if we have findings
        error_chain_text = self._get_error_chain_text()
        
        prompt = f"""
{context}
{history_text}
{error_chain_text}

=== CURRENT STATE ===
Iteration: {iteration} of {self.max_iterations}

You are an expert debugging agent. Based on the context above and any previous tool calls, 
decide what to do next.

Available tools:

- search_jaeger_traces: For distributed tracing, service calls, latency issues

IMPORTANT - Trace Analysis Guidelines (ALWAYS FOLLOW):
1. When analyzing traces, ALWAYS examine the FULL trace hierarchy (parent + child spans)
2. If parent service shows error, look at child spans to find the root cause
3. Trace the error chain: which service called which, and what error occurred in downstream services
4. Common pattern: Payment API fails → check child spans → find Beneficiary API failed → find actual error message
5. Use the ReAct loop: if first query returns no results, try different tags (e.g., ucic → customer_id)

IMPORTANT - Jaeger Time Range Iteration (ALWAYS FOLLOW):
- Jaeger searches ONE 24h time range per call using 'time_range_index' parameter
- time_range_index=0 means 0-24h ago (most recent), 1 means 24-48h ago, ..., 6 means 144-168h ago
- ALWAYS start with time_range_index=0
- If NO TRACES FOUND: call again with time_range_index=1, then 2, etc. until 6
- If TRACES WITH ERRORS FOUND: stop searching, use that data for diagnosis
- If NO TRACES FOUND: you MUST continue to next time_range_index (0→1→2→3→4→5→6)
- CRITICAL: You MUST search ALL 7 time ranges (0-6) before concluding no traces exist
- Only after searching ALL 7 ranges with NO traces can you conclude it's a data/CBS issue, not a runtime error
- If WARNING about unknown tag: note the known tags and try those in next iteration
- MAX 7 calls per iteration (covering 7 days total)

IMPORTANT - Iteration Strategy (ALWAYS FOLLOW):
- Each iteration = one complete search across all 7 time ranges (0-6)
- If NO USEFUL DATA after 7 time ranges in one iteration, start NEW ITERATION with:
  - Different service name (e.g., kyc-service → RE-KYC-API)
  - OR different tag (e.g., ucic → customer_id)
- MAX 5 ITERATIONS allowed (worst case: 5 × 7 = 35 API calls)
- Stop early if root cause is found

IMPORTANT - When calling search_jaeger_traces:
- Use the 'app' value from the INCIDENT CONTEXT above (e.g., optimus, cbs, idp)
- Use the 'service' from AVAILABLE JAEGER SERVICES section
- Use customer identifiers from Customer Identifiers section (e.g., UCIC, customer_id, account_number)
- ALWAYS include time_range_index parameter (start with 0)
- NEVER leave these fields empty - always use values from the context
- If one tag returns no results, try alternative tags in next iteration

Your decision should be based on:
1. What has already been tried
2. What the findings suggest needs to be investigated next
3. Whether the issue is already resolved

CRITICAL RULE - When to ask_user:
- ONLY use ask_user AFTER you have exhausted ALL available tools (Jaeger, ELK, DB queries)
- You must complete at least 3 iterations with multiple tool calls before asking questions
- If no traces/logs found after exhaustive search (5 iterations × 7 time ranges = 35 calls), THEN you may ask_user
- NEVER ask_user just because you're unsure - try harder first!
- The user expects you to investigate thoroughly, not give up early

Output in this format:
ACTION: [resolve|continue|ask_user]
REASONING: [why you chose this action]
TOOL: [search_jaeger_traces|none]
INPUT: [JSON of tool parameters - MUST include app, service, tag_name, tag_value from context]
DIAGNOSIS: [if resolving, what's the root cause]
SOLUTION: [if resolving, how to fix it]
QUESTION: [if asking user, what to ask]
"""
# TOOL: [search_elk_logs|execute_db_query|get_table_schema|list_tables|none]

# - search_elk_logs: For detailed application logs, errors, stack traces
# - execute_db_query: For account data, status, balances, freezes
# - get_table_schema: To discover table columns before writing queries
# - list_tables: To find available tables
        
        # Use simple LLM call for decision
        decision_agent = Agent(
            role="Decision Maker",
            goal="Decide the next debugging action",
            backstory=(
                "You are a debugging orchestrator. Your job is to analyze "
                "the current state and decide what tool to call next, "
                "or if the issue is resolved."
            ),
            verbose=False,
            allow_delegation=False,
            llm=self.llm,
            temperature=0
        )
        
        decision_task = Task(
            description=prompt,
            agent=decision_agent,
            expected_output=(
                "Structured decision with ACTION, REASONING, TOOL, INPUT, "
                "DIAGNOSIS, SOLUTION, and QUESTION fields"
            )
        )
        
        crew = Crew(
            agents=[decision_agent],
            tasks=[decision_task],
            verbose=False
        )
        
        result = await crew.akickoff()
        result_text = str(result)
        
        # Parse the response
        return self._parse_decision(result_text)
    
    def _parse_decision(self, response: str) -> Dict:
        import re
        
        # Extract action
        action_match = re.search(r"ACTION:\s*(\w+)", response, re.IGNORECASE)
        action = action_match.group(1).lower() if action_match else "continue"
        
        # Extract reasoning
        reasoning_match = re.search(r"REASONING:\s*(.+?)(?:INPUT:|DIAGNOSIS:|$)", response, re.DOTALL)
        reasoning = reasoning_match.group(1).strip() if reasoning_match else ""
        
        # Extract tool
        tool_match = re.search(r"TOOL:\s*(\w+)", response, re.IGNORECASE)
        tool = tool_match.group(1).lower() if tool_match else ""
        
        # Extract input
        input_match = re.search(r"INPUT:\s*(\{.+?\})", response, re.DOTALL)
        tool_input = {}
        if input_match:
            try:
                import json
                tool_input = json.loads(input_match.group(1))
            except:
                tool_input = {"query": input_match.group(1)}
        
        # Extract diagnosis
        diagnosis_match = re.search(r"DIAGNOSIS:\s*(.+?)(?:SOLUTION:|$)", response, re.DOTALL)
        diagnosis = diagnosis_match.group(1).strip() if diagnosis_match else ""
        
        # Extract solution
        solution_match = re.search(r"SOLUTION:\s*(.+?)(?:QUESTION:|$)", response, re.DOTALL)
        solution = solution_match.group(1).strip() if solution_match else ""
        
        # Extract question
        question_match = re.search(r"QUESTION:\s*(.+)$", response, re.DOTALL)
        question = question_match.group(1).strip() if question_match else ""
        
        return {
            "action": action,
            "reasoning": reasoning,
            "tool": tool,
            "input": tool_input,
            "diagnosis": diagnosis,
            "solution": solution,
            "question": question
        }

    def _analyze_trace_for_errors(self, jaeger_result: str, iteration: int) -> Dict:
        """
        Analyze Jaeger trace results for errors and build error chain.
        
        Returns:
            dict with:
                - has_errors: bool
                - root_cause_found: bool (error with no child errors)
                - new_errors: list of ErrorChainEntry
        """
        import json
        
        new_errors = []
        
        try:
            # Try to parse the JSON response
            data = json.loads(jaeger_result)
            spans = data.get('data', [])
            
            if not spans:
                return {"has_errors": False, "root_cause_found": False, "new_errors": []}
            
            # Build parent-child map
            parent_to_children: Dict[str, List[Dict]] = {}
            span_info: Dict[str, Dict] = {}
            
            for span in spans:
                span_id = span.get('spanID', '')
                refs = span.get('references', [])
                
                # Get parent span ID
                parent_span_id = None
                for ref in refs:
                    if ref.get('refType') == 'CHILD_OF':
                        parent_span_id = ref.get('spanID')
                        break
                
                span_info[span_id] = {
                    'service': span.get('processID', 'unknown'),
                    'operation': span.get('operationName', 'unknown'),
                    'parent_span_id': parent_span_id,
                    'span_id': span_id
                }
                
                if parent_span_id:
                    if parent_span_id not in parent_to_children:
                        parent_to_children[parent_span_id] = []
                    parent_to_children[parent_span_id].append(span_id)
            
            # Find spans with errors (check tags for error=true)
            error_span_ids = set()
            for span in spans:
                tags = span.get('tags', [])
                for tag in tags:
                    if tag.get('key') == 'error' and tag.get('value') == True:
                        error_span_ids.add(span.get('spanID'))
                        break
                # Also check logs for error-level events
                logs = span.get('logs', [])
                for log in logs:
                    fields = log.get('fields', [])
                    for field in fields:
                        if field.get('key') == 'level' and field.get('value') == 'error':
                            error_span_ids.add(span.get('spanID'))
                            break
            
            # For each error span, determine if it's root cause (no children with errors)
            for span_id in error_span_ids:
                span = next((s for s in spans if s.get('spanID') == span_id), None)
                if not span:
                    continue
                
                # Check if this span has children that also have errors
                children = parent_to_children.get(span_id, [])
                child_has_error = any(child_id in error_span_ids for child_id in children)
                
                # Get error message from logs
                error_message = "Error found in span"
                logs = span.get('logs', [])
                for log in logs:
                    fields = log.get('fields', [])
                    for field in fields:
                        if field.get('key') == 'error':
                            error_message = field.get('value', error_message)
                            break
                
                # Get service name from process
                process_id = span.get('processID', 'unknown')
                
                entry = ErrorChainEntry(
                    service=process_id,
                    operation=span.get('operationName', 'unknown'),
                    error_message=error_message,
                    iteration=iteration,
                    is_root_cause=not child_has_error,  # Root if no child errors
                    parent_span_id=span_info.get(span_id, {}).get('parent_span_id'),
                    span_id=span_id
                )
                new_errors.append(entry)
            
            # Update error chain
            self.error_chain.extend(new_errors)
            
            # Mark root causes properly
            # An error is root cause if it has no children with errors
            for entry in self.error_chain:
                if entry.span_id in parent_to_children:
                    children = parent_to_children[entry.span_id]
                    # If any child has an error, this is not root cause
                    if any(child_id in error_span_ids for child_id in children):
                        entry.is_root_cause = False
            
            has_errors = len(new_errors) > 0
            root_cause_found = any(e.is_root_cause for e in self.error_chain)
            
            logger.info(f"[ErrorChain] Found {len(new_errors)} errors, root cause found: {root_cause_found}")
            
            return {
                "has_errors": has_errors,
                "root_cause_found": root_cause_found,
                "new_errors": new_errors
            }
            
        except json.JSONDecodeError:
            # Not JSON, check for simple error patterns
            result_lower = jaeger_result.lower()
            if 'error' in result_lower and 'trace' in result_lower:
                return {"has_errors": True, "root_cause_found": False, "new_errors": []}
            return {"has_errors": False, "root_cause_found": False, "new_errors": []}
    
    def _get_error_chain_text(self) -> str:
        """Get formatted error chain for context."""
        if not self.error_chain:
            return ""
        
        lines = ["=== ERROR CHAIN FOUND ==="]
        for entry in self.error_chain:
            root_marker = "ROOT CAUSE" if entry.is_root_cause else "symptom"
            lines.append(f"- {entry.service}: {entry.error_message} (iteration {entry.iteration}, {root_marker})")
        
        return "\n".join(lines)

    async def _execute_tool(
        self,
        tool_name: str,
        tool_input: Dict,
        app: str
    ) -> str:
        try:
            # Query Validation for SQL queries
            if tool_name == "execute_db_query":
                query = tool_input.get("query", "")
                validation = validate_sql_query(query)
                
                if not validation["is_safe"]:
                    # Log the blocked query
                    await audit_logger.log_sql_query(
                        incident_id=self.incident_id,
                        sql_query=query,
                        result=f"BLOCKED: {validation['reason']}",
                        db_instance=tool_input.get("db_instance", "main")
                    )
                    return f"Query blocked for safety: {validation['reason']}"

            # Execute the tool
            if tool_name == "search_jaeger_traces":
                result = await self.jaeger_tool._arun(
                    app=tool_input.get("app"),
                    service=tool_input.get("service"),
                    tag_name=tool_input.get("tag_name"),
                    tag_value=tool_input.get("tag_value"),
                    time_range_index=tool_input.get("time_range_index", 0)
                )

                # Audit log
                await audit_logger.log_tool_execution(
                    incident_id=self.incident_id,
                    tool_name=tool_name,
                    input_params=tool_input,
                    output=result
                )
                return result

            elif tool_name == "search_elk_logs":
                result = await self.elk_tool._arun(
                    query_json=tool_input.get("query_json", "{}"),
                    parameter_name=tool_input.get("parameter_name"),
                    parameter_value=tool_input.get("parameter_value")
                )

                # Audit log
                await audit_logger.log_tool_execution(
                    incident_id=self.incident_id,
                    tool_name=tool_name,
                    input_params=tool_input,
                    output=result
                )
                return result

            elif tool_name == "execute_db_query":
                result = await self.sql_tool._arun(
                    query=tool_input.get("query", "SELECT * FROM DUAL"),
                    db_instance=tool_input.get("db_instance", "main")
                )

                # Audit log SQL query
                await audit_logger.log_sql_query(
                    incident_id=self.incident_id,
                    sql_query=tool_input.get("query", ""),
                    result=result[:500] if len(result) > 500 else result,
                    db_instance=tool_input.get("db_instance", "main")
                )
                return result

            elif tool_name == "get_table_schema":
                result = await self.schema_tool._arun(
                    table_name=tool_input.get("table_name", "GLDM"),
                    app=app
                )

                # Audit log
                await audit_logger.log_tool_execution(
                    incident_id=self.incident_id,
                    tool_name=tool_name,
                    input_params=tool_input,
                    output=result
                )
                return result

            elif tool_name == "list_tables":
                result = await self.list_tables_tool._arun(
                    pattern=tool_input.get("pattern", "%"),
                    app=app
                )

                # Audit log
                await audit_logger.log_tool_execution(
                    incident_id=self.incident_id,
                    tool_name=tool_name,
                    input_params=tool_input,
                    output=result
                )
                return result

            else:
                return f"Unknown tool: {tool_name}"
        
        except Exception as e:
            error_msg = f"Tool execution error: {str(e)}"
            
            # Log the error
            await audit_logger.log_tool_execution(
                incident_id=self.incident_id,
                tool_name=tool_name,
                input_params=tool_input,
                output=error_msg,
                success=False
            )
            
            return error_msg

    # ===== ENFORCED ITERATION LOGIC (NOT LEFT TO LLM) =====
    
    def _is_no_traces_result(self, result: str) -> bool:
        """Check if the tool result indicates no traces were found."""
        result_lower = result.lower()
        no_trace_indicators = [
            "no traces found",
            "no traces in time range",
            "0 traces",
            "traces found: 0"
        ]
        return any(indicator in result_lower for indicator in no_trace_indicators)
    
    def _has_invalid_service_tag_warning(self, result: str) -> bool:
        """Check if result contains WARNING about invalid service or tag."""
        result_lower = result.lower()
        # Detect warnings about invalid service or tag
        warning_indicators = [
            "warning",
            "not in known tags",
            "not a valid service",
            "unknown tag",
            "unknown service"
        ]
        has_warning = "warning" in result_lower
        has_invalid = any(indicator in result_lower for indicator in warning_indicators[1:])
        return has_warning and has_invalid
    
    def _check_and_enforce_time_range(self, tool_input: dict) -> dict:
        service = tool_input.get("service", "")
        tag_name = tool_input.get("tag_name", "")
        tag_value = tool_input.get("tag_value", "")
        
        requested_index = tool_input.get("time_range_index", 0)
        
        if requested_index != self.current_time_range_index:
            logger.warning(f"[ExecuteAgent] LLM requested range {requested_index}, enforcing tracked range {self.current_time_range_index}")
        
        # ALWAYS use our tracked index - never let LLM dictate the range
        tool_input["time_range_index"] = self.current_time_range_index
        
        # Track current service/tag being queried
        self.current_service = service
        self.current_tag_name = tag_name
        self.current_tag_value = tag_value
        
        return tool_input
    
    def _after_tool_execution(self, tool_name: str, tool_input: dict, result: str) -> bool:
        """
        Auto-advance time range after no-traces result - do NOT ask LLM.
        Returns True if should break to new iteration.
        """
        if tool_name != "search_jaeger_traces":
            return False
        
        # Check for invalid service/tag WARNING - this should trigger NEW ITERATION
        if self._has_invalid_service_tag_warning(result):
            logger.warning(f"[ExecuteAgent] WARNING: Invalid service/tag detected - breaking to NEW ITERATION")
            return True  # Signal to break to new iteration
        
        # Record this combination as exhausted
        service = tool_input.get("service", "")
        tag_name = tool_input.get("tag_name", "")
        tag_value = tool_input.get("tag_value", "")
        range_index = tool_input.get("time_range_index", self.current_time_range_index)
        
        self.ranges_exhausted.add((service, tag_name, tag_value, range_index))
        logger.info(f"[ExecuteAgent] Recorded exhaustion: service={service}, tag={tag_name}, range={range_index}")
        
        # If no traces found, AUTO-ADVANCE to next time range
        if self._is_no_traces_result(result):
            if self.current_time_range_index < 6:
                self.current_time_range_index += 1
                logger.info(f"[ExecuteAgent] No traces found at range {range_index}, AUTO-advancing to range {self.current_time_range_index}")
            else:
                logger.info(f"[ExecuteAgent] ALL 7 time ranges exhausted (0-6) for service={service}, tag={tag_name}")
                return True  # Signal to break to new iteration
        
        return False  # Continue within same iteration
    
    def _can_resolve(self) -> bool:
        """BLOCK resolve until ALL 7 time ranges (0-6) are exhausted for current service/tag."""
        # We can only resolve if we've tried range 6 and got no traces
        if self.current_time_range_index >= 6:
            # Check if range 6 was exhausted
            key = (self.current_service, self.current_tag_name, self.current_tag_value, 6)
            if key in self.ranges_exhausted:
                logger.info(f"[ExecuteAgent] All 7 ranges exhausted - resolve allowed")
                return True
        
        logger.info(f"[ExecuteAgent] Resolve blocked - current range index: {self.current_time_range_index}, need 6 with no traces")
        return False
    
    def _force_continue_with_next_range(self) -> dict:
        if self.current_time_range_index < 6:
            return {
                "action": "continue",
                "tool": "search_jaeger_traces",
                "input": {
                    "service": self.current_service,
                    "tag_name": self.current_tag_name,
                    "tag_value": self.current_tag_value,
                    "time_range_index": self.current_time_range_index
                },
                "reasoning": f"Auto-advancing to time_range_index={self.current_time_range_index} - previous range returned no traces"
            }
        else:
            # All ranges exhausted - trigger new iteration
            return {
                "action": "new_iteration_needed",
                "reasoning": "All 7 time ranges exhausted - need to try different service/tag combination"
            }


async def run_execute_agent_async(
    plan_output: PlanOutput,
    incident_description: str,
    app: str,
    customer_identifiers: Dict[str, str],
    problem_category: str,
    max_iterations: int = 5,
    incident_id: str = "unknown",
    discovered_services: str = ""
) -> ExecutionResult:
    agent = ExecuteAgent(max_iterations=max_iterations)
    
    return await agent.execute(
        plan_output=plan_output,
        incident_description=incident_description,
        app=app,
        customer_identifiers=customer_identifiers,
        problem_category=problem_category,
