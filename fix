"""
LLM Cache Utility for Incident Manager.

Implements caching for LLM instances to avoid recreating them on every call.
Uses a singleton pattern to ensure LLM instances are reused.
"""

import os
import threading
from typing import Dict, Optional, Any
from dataclasses import dataclass

os.environ["OTEL_SDK_DISABLED"] = "true"

logger = __import__('logging').getLogger(__name__)


@dataclass
class LLMInstanceKey:
    """Key for LLM instance cache."""
    model_name: str
    temperature: float
    base_url: str
    
    def __hash__(self):
        return hash((self.model_name, self.temperature, self.base_url))
    
    def __eq__(self, other):
        if not isinstance(other, LLMInstanceKey):
            return False
        return (self.model_name == other.model_name and 
                self.temperature == other.temperature and 
                self.base_url == other.base_url)


class LLMCache:
    """
    Thread-safe cache for LLM instances.
    
    Reuses LLM instances with same configuration to avoid overhead
    of creating new instances on every call.
    """
    
    def __init__(self, max_size: int = 10):
        self.max_size = max_size
        self._cache: Dict[LLMInstanceKey, Any] = {}
        self._lock = threading.RLock()
        self._access_count: Dict[LLMInstanceKey, int] = {}
    
    def get(
        self,
        model_name: str,
        temperature: float,
        base_url: str,
        api_key: str,
        llm_factory=None
    ) -> Any:
        """
        Get or create an LLM instance.
        
        Args:
            model_name: Model name
            temperature: Temperature setting
            base_url: API base URL
            api_key: API key
            llm_factory: Factory function to create LLM if not cached
            
        Returns:
            Cached or newly created LLM instance
        """
        key = LLMInstanceKey(model_name, temperature, base_url)
        
        with self._lock:
            if key in self._cache:
                self._access_count[key] = self._access_count.get(key, 0) + 1
                logger.debug(f"LLM cache hit for {model_name} @ temp={temperature}")
                return self._cache[key]
            
            # Cache miss - create new instance
            if llm_factory is None:
                from crewai import LLM
                llm_instance = LLM(
                    model="openai/" + model_name,
                    temperature=temperature,
                    base_url=base_url,
                    api_key=api_key
                )
            else:
                llm_instance = llm_factory(model_name, temperature, base_url, api_key)
            
            # Evict oldest if at capacity
            if len(self._cache) >= self.max_size:
                self._evict_lru()
            
            self._cache[key] = llm_instance
            self._access_count[key] = 1
            logger.info(f"LLM cache miss - created new instance for {model_name}")
            
            return llm_instance
    
    def _evict_lru(self) -> None:
        """Evict least recently used LLM instance."""
        if not self._access_count:
            return
        
        # Find least recently used (lowest access count)
        lru_key = min(self._access_count, key=self._access_count.get)
        del self._cache[lru_key]
        del self._access_count[lru_key]
        logger.debug(f"LLM cache evicted {lru_key.model_name}")
    
    def clear(self) -> None:
        """Clear all cached LLM instances."""
        with self._lock:
            self._cache.clear()
            self._access_count.clear()
            logger.info("LLM cache cleared")
    
    def get_stats(self) -> Dict[str, int]:
        """Get cache statistics."""
        with self._lock:
            return {
                "size": len(self._cache),
                "max_size": self.max_size,
                "access_counts": dict(self._access_count)
            }


# Global LLM cache instance
_llm_cache: Optional[LLMCache] = None
_cache_lock = threading.Lock()


def get_llm_cache() -> LLMCache:
    """Get the global LLM cache instance."""
    global _llm_cache
    if _llm_cache is None:
        with _cache_lock:
            if _llm_cache is None:
                _llm_cache = LLMCache(max_size=10)
    return _llm_cache


def get_cached_llm(
    model_name: str,
    temperature: float = 0.0,
    base_url: str = None,
    api_key: str = None
) -> Any:
    """
    Get a cached LLM instance.
    
    This is the main entry point for getting LLM instances.
    It will reuse existing instances when possible.
    
    Args:
        model_name: Model name (e.g., "gpt-4o")
        temperature: Temperature setting (default: 0.0)
        base_url: API base URL (defaults to llm_config.url)
        api_key: API key (defaults to llm_config.token)
        
    Returns:
        Cached or new LLM instance
    """
    from utils.llm import llm_config

    if base_url is None:
        base_url = llm_config.url
    if api_key is None:
        api_key = llm_config.token

    cache = get_llm_cache()

    return cache.get(
        model_name=model_name,
        temperature=temperature,
        base_url=base_url,
        api_key=api_key
    )


# Convenience function for creating cached CrewAI LLM instances
def create_cached_llm(
    model_name: str,
    temperature: float = 0.0,
    base_url: str = None,
    api_key: str = None
) -> Any:
    """
    Create a cached LLM instance for CrewAI.
    
