    # ===== ENFORCED ITERATION LOGIC (NOT LEFT TO LLM) =====
    
    def _is_no_traces_result(self, result: str) -> bool:
        """Check if the tool result indicates no traces were found."""
        result_lower = result.lower()
        no_trace_indicators = [
            "no traces found",
            "no traces in time range",
            "0 traces",
            "traces found: 0"
        ]
        return any(indicator in result_lower for indicator in no_trace_indicators)
    
    def _has_invalid_service_tag_warning(self, result: str) -> bool:
        """Check if result contains WARNING about invalid service or tag."""
        result_lower = result.lower()
        # Detect warnings about invalid service or tag
        warning_indicators = [
            "warning",
            "not in known tags",
            "not a valid service",
            "unknown tag",
            "unknown service"
        ]
        has_warning = "warning" in result_lower
        has_invalid = any(indicator in result_lower for indicator in warning_indicators[1:])
        return has_warning and has_invalid
    
    def _check_and_enforce_time_range(self, tool_input: dict) -> dict:
        service = tool_input.get("service", "")
        tag_name = tool_input.get("tag_name", "")
        tag_value = tool_input.get("tag_value", "")
        
        requested_index = tool_input.get("time_range_index", 0)
        
        if requested_index != self.current_time_range_index:
            logger.warning(f"[ExecuteAgent] LLM requested range {requested_index}, enforcing tracked range {self.current_time_range_index}")
        
        # ALWAYS use our tracked index - never let LLM dictate the range
        tool_input["time_range_index"] = self.current_time_range_index
        
        # Track current service/tag being queried
        self.current_service = service
        self.current_tag_name = tag_name
        self.current_tag_value = tag_value
        
        return tool_input
    
    def _after_tool_execution(self, tool_name: str, tool_input: dict, result: str) -> bool:
        """
        Auto-advance time range after no-traces result - do NOT ask LLM.
        Returns True if should break to new iteration.
        """
        if tool_name != "search_jaeger_traces":
            return False
        
        # Check for invalid service/tag WARNING - this should trigger NEW ITERATION
        if self._has_invalid_service_tag_warning(result):
            logger.warning(f"[ExecuteAgent] WARNING: Invalid service/tag detected - breaking to NEW ITERATION")
            return True  # Signal to break to new iteration
        
        # Record this combination as exhausted
        service = tool_input.get("service", "")
        tag_name = tool_input.get("tag_name", "")
        tag_value = tool_input.get("tag_value", "")
        range_index = tool_input.get("time_range_index", self.current_time_range_index)
        
        self.ranges_exhausted.add((service, tag_name, tag_value, range_index))
        logger.info(f"[ExecuteAgent] Recorded exhaustion: service={service}, tag={tag_name}, range={range_index}")
        
        # If no traces found, AUTO-ADVANCE to next time range
        if self._is_no_traces_result(result):
            if self.current_time_range_index < 6:
                self.current_time_range_index += 1
                logger.info(f"[ExecuteAgent] No traces found at range {range_index}, AUTO-advancing to range {self.current_time_range_index}")
            else:
                logger.info(f"[ExecuteAgent] ALL 7 time ranges exhausted (0-6) for service={service}, tag={tag_name}")
                return True  # Signal to break to new iteration
        
        return False  # Continue within same iteration
    
    def _can_resolve(self) -> bool:
        """BLOCK resolve until ALL 7 time ranges (0-6) are exhausted for current service/tag."""
        # We can only resolve if we've tried range 6 and got no traces
        if self.current_time_range_index >= 6:
            # Check if range 6 was exhausted
            key = (self.current_service, self.current_tag_name, self.current_tag_value, 6)
            if key in self.ranges_exhausted:
                logger.info(f"[ExecuteAgent] All 7 ranges exhausted - resolve allowed")
                return True
        
        logger.info(f"[ExecuteAgent] Resolve blocked - current range index: {self.current_time_range_index}, need 6 with no traces")
        return False
    
    def _force_continue_with_next_range(self) -> dict:
        if self.current_time_range_index < 6:
            return {
                "action": "continue",
                "tool": "search_jaeger_traces",
                "input": {
                    "service": self.current_service,
                    "tag_name": self.current_tag_name,
                    "tag_value": self.current_tag_value,
                    "time_range_index": self.current_time_range_index
                },
                "reasoning": f"Auto-advancing to time_range_index={self.current_time_range_index} - previous range returned no traces"
            }
        else:
            # All ranges exhausted - trigger new iteration
            return {
                "action": "new_iteration_needed",
                "reasoning": "All 7 time ranges exhausted - need to try different service/tag combination"
            }


