        return self._parse_decision(result_text)
    
    def _parse_decision(self, response: str) -> Dict:
        import re
        
        # Extract action
        action_match = re.search(r"ACTION:\s*(\w+)", response, re.IGNORECASE)
        action = action_match.group(1).lower() if action_match else "continue"
        
        # Extract reasoning
        reasoning_match = re.search(r"REASONING:\s*(.+?)(?:INPUT:|DIAGNOSIS:|$)", response, re.DOTALL)
        reasoning = reasoning_match.group(1).strip() if reasoning_match else ""
        
        # Extract tool
        tool_match = re.search(r"TOOL:\s*(\w+)", response, re.IGNORECASE)
        tool = tool_match.group(1).lower() if tool_match else ""
        
        # Extract input
        input_match = re.search(r"INPUT:\s*(\{.+?\})", response, re.DOTALL)
        tool_input = {}
        if input_match:
            try:
                import json
                tool_input = json.loads(input_match.group(1))
            except:
                tool_input = {"query": input_match.group(1)}
        
        # Extract diagnosis
        diagnosis_match = re.search(r"DIAGNOSIS:\s*(.+?)(?:SOLUTION:|$)", response, re.DOTALL)
        diagnosis = diagnosis_match.group(1).strip() if diagnosis_match else ""
        
        # Extract solution
        solution_match = re.search(r"SOLUTION:\s*(.+?)(?:QUESTION:|$)", response, re.DOTALL)
        solution = solution_match.group(1).strip() if solution_match else ""
        
        # Extract question
        question_match = re.search(r"QUESTION:\s*(.+)$", response, re.DOTALL)
        question = question_match.group(1).strip() if question_match else ""
        
        return {
            "action": action,
            "reasoning": reasoning,
            "tool": tool,
            "input": tool_input,
            "diagnosis": diagnosis,
            "solution": solution,
            "question": question
        }

    def _analyze_trace_for_errors(self, jaeger_result: str, iteration: int) -> Dict:
        """
        Analyze Jaeger trace results for errors and build error chain.
        
        Returns:
            dict with:
                - has_errors: bool
                - root_cause_found: bool (error with no child errors)
                - new_errors: list of ErrorChainEntry
        """
        import json
        
        new_errors = []
        
        try:
            # Try to parse the JSON response
            data = json.loads(jaeger_result)
            spans = data.get('data', [])
            
            if not spans:
                return {"has_errors": False, "root_cause_found": False, "new_errors": []}
            
            # Build parent-child map
            parent_to_children: Dict[str, List[Dict]] = {}
            span_info: Dict[str, Dict] = {}
            
            for span in spans:
                span_id = span.get('spanID', '')
                refs = span.get('references', [])
                
                # Get parent span ID
                parent_span_id = None
                for ref in refs:
                    if ref.get('refType') == 'CHILD_OF':
                        parent_span_id = ref.get('spanID')
                        break
                
                span_info[span_id] = {
                    'service': span.get('processID', 'unknown'),
                    'operation': span.get('operationName', 'unknown'),
                    'parent_span_id': parent_span_id,
                    'span_id': span_id
                }
                
                if parent_span_id:
                    if parent_span_id not in parent_to_children:
                        parent_to_children[parent_span_id] = []
                    parent_to_children[parent_span_id].append(span_id)
            
            # Find spans with errors (check tags for error=true)
            error_span_ids = set()
            for span in spans:
                tags = span.get('tags', [])
                for tag in tags:
                    if tag.get('key') == 'error' and tag.get('value') == True:
                        error_span_ids.add(span.get('spanID'))
                        break
                # Also check logs for error-level events
                logs = span.get('logs', [])
                for log in logs:
                    fields = log.get('fields', [])
                    for field in fields:
                        if field.get('key') == 'level' and field.get('value') == 'error':
                            error_span_ids.add(span.get('spanID'))
                            break
            
            # For each error span, determine if it's root cause (no children with errors)
            for span_id in error_span_ids:
                span = next((s for s in spans if s.get('spanID') == span_id), None)
                if not span:
                    continue
                
                # Check if this span has children that also have errors
                children = parent_to_children.get(span_id, [])
                child_has_error = any(child_id in error_span_ids for child_id in children)
                
                # Get error message from logs
                error_message = "Error found in span"
                logs = span.get('logs', [])
                for log in logs:
                    fields = log.get('fields', [])
                    for field in fields:
                        if field.get('key') == 'error':
                            error_message = field.get('value', error_message)
                            break
                
                # Get service name from process
                process_id = span.get('processID', 'unknown')
                
                entry = ErrorChainEntry(
                    service=process_id,
                    operation=span.get('operationName', 'unknown'),
                    error_message=error_message,
                    iteration=iteration,
                    is_root_cause=not child_has_error,  # Root if no child errors
                    parent_span_id=span_info.get(span_id, {}).get('parent_span_id'),
                    span_id=span_id
                )
                new_errors.append(entry)
            
            # Update error chain
            self.error_chain.extend(new_errors)
            
            # Mark root causes properly
            # An error is root cause if it has no children with errors
            for entry in self.error_chain:
                if entry.span_id in parent_to_children:
                    children = parent_to_children[entry.span_id]
                    # If any child has an error, this is not root cause
                    if any(child_id in error_span_ids for child_id in children):
                        entry.is_root_cause = False
            
            has_errors = len(new_errors) > 0
            root_cause_found = any(e.is_root_cause for e in self.error_chain)
            
            logger.info(f"[ErrorChain] Found {len(new_errors)} errors, root cause found: {root_cause_found}")
            
            return {
                "has_errors": has_errors,
                "root_cause_found": root_cause_found,
                "new_errors": new_errors
            }
            
        except json.JSONDecodeError:
            # Not JSON, check for simple error patterns
            result_lower = jaeger_result.lower()
            if 'error' in result_lower and 'trace' in result_lower:
                return {"has_errors": True, "root_cause_found": False, "new_errors": []}
            return {"has_errors": False, "root_cause_found": False, "new_errors": []}
    
    def _get_error_chain_text(self) -> str:
        """Get formatted error chain for context."""
        if not self.error_chain:
            return ""
        
        lines = ["=== ERROR CHAIN FOUND ==="]
        for entry in self.error_chain:
            root_marker = "ROOT CAUSE" if entry.is_root_cause else "symptom"
            lines.append(f"- {entry.service}: {entry.error_message} (iteration {entry.iteration}, {root_marker})")
        
        return "\n".join(lines)

