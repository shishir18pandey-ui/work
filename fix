        masked_payload, extracted_identifiers = mask_payload_input(payload)
        logger.info("++++++++")
        logger.info(f"masked: {masked_payload}")
        logger.info("++++++++")

        
        if extracted_identifiers:
            for key, value in extracted_identifiers.items():
                if key not in payload or not payload.get(key):
                    payload[key] = value
                    logger.info(f"Extracted {key} from description: {value}")
        
        span.set_attribute("short_description_length", len(payload.get('shortDescription','')))
        span.set_attribute("description_length", len(payload.get('description','')))
        span.set_attribute("individualUCIC", payload.get('individualUCIC','i'))

        short_description = masked_payload.get('shortDescription', payload.get('shortDescription',''))
        description = masked_payload.get('description', payload.get('description',''))
        individualUCIC = payload.get('individualUCIC','i')
