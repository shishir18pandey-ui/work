        description="All tool calls made during execution"
    )
    final_state: str = Field(
        description="Final state description"
    )
    confidence: float = Field(
        default=1.0,
        description="Confidence score 0-1 for the resolution"
    )
    escalation_reason: Optional[str] = Field(
        default=None,
        description="Reason for escalation if confidence < 0.3"
    )


class ToolCallRecord(BaseModel):
    tool_name: str
    input_params: Dict
    output: str
    iteration: int
    reasoning: str


class ErrorChainEntry(BaseModel):
    """Represents an error found in the trace hierarchy."""
    service: str
    operation: str
    error_message: str
    iteration: int
    is_root_cause: bool = False
    parent_span_id: Optional[str] = None
    span_id: str


class ExecuteAgent:
    
    def __init__(self, max_iterations: int = 5):
        self.max_iterations = max_iterations
        self.llm = create_cached_llm(
            model_name=llm_config.model_name,
            temperature=0.0,
            base_url=llm_config.url,
            api_key=llm_config.token
        )

        self.jaeger_tool = JaegerTraceTool()
        # self.elk_tool = ELKQueryTool()  # TODO: Enable when ELK is ready
        # self.sql_tool = SQLQueryTool()  # TODO: Enable when DB is ready
        # self.schema_tool = GetTableSchemaTool()  # TODO: Enable when DB is ready
        # self.list_tables_tool = ListTablesTool()  # TODO: Enable when DB is ready

        self.tool_failure_tracker = get_tool_failure_tracker()
        self.error_chain: List[ErrorChainEntry] = []
        
        # ===== ENFORCED ITERATION STATE =====
        # Track time range iteration programmatically - NOT left to LLM
        self.current_time_range_index = 0  # ALWAYS start at 0 (most recent)
        self.current_service = None  # Track current service being queried
        self.current_tag_name = None  # Track current tag being used
        self.current_tag_value = None  # Track current tag value
        self.ranges_exhausted = set()  # Track (service, tag_name, tag_value, range_index) exhausted
        self.all_services_tried_per_iteration = {}  # Track services/tags tried per iteration
        # ====================================

    async def execute(
        self,
        plan_output: PlanOutput,
        incident_description: str,
        app: str,
        customer_identifiers: Dict[str, str],
        problem_category: str,
        incident_id: str = "unknown",
        discovered_services: str = ""
    ) -> ExecutionResult:
        self.incident_id = incident_id
        self.discovered_services = discovered_services
        tool_calls = []
        context = self._build_initial_context(
            plan_output,
            incident_description,
            app,
            customer_identifiers,
            problem_category
        )

        self.current_time_range_index = 0
        self.current_service = None
        self.current_tag_name = None
        self.current_tag_value = None
        self.ranges_exhausted = set()
        self.all_services_tried_per_iteration = {}

        for iteration in range(1, self.max_iterations + 1):
            logger.info(f"[ExecuteAgent] === ITERATION {iteration} START - range={self.current_time_range_index} ===")
            
            context = await self._manage_context(context, tool_calls)

            decision = await self._decide_next_action(
                context,
                tool_calls,
                iteration
            )

            if decision.get("action") == "resolve":
                if not self._can_resolve():
                    logger.info(f"[ExecuteAgent] BLOCKING resolve - ranges not exhausted yet. Auto-continuing...")
                    force_decision = self._force_continue_with_next_range()
                    
                    if force_decision.get("action") == "new_iteration_needed":
                        logger.info(f"[ExecuteAgent] All ranges exhausted - will start NEW ITERATION")
                        self.current_time_range_index = 0
                        self.ranges_exhausted = set()
                        continue
                    else:
                        decision = force_decision
                        tool_name = decision.get("tool")
                        tool_input = decision.get("input", {})

                        if tool_name == "search_jaeger_traces":
                            tool_input = self._check_and_enforce_time_range(tool_input)
                            logger.info(f"[ExecuteAgent] Auto-continuing with time_range_index={tool_input.get('time_range_index')}")
                        
                        result = await self._execute_tool(tool_name, tool_input, app)
                        
                        call_record = ToolCallRecord(
                            tool_name=tool_name,
                            input_params=tool_input,
                            output=result,
                            iteration=iteration,
                            reasoning=decision.get("reasoning", "")
                        )
                        tool_calls.append(call_record.model_dump())
                        
                        # Auto-advance after this forced call
                        if tool_name == "search_jaeger_traces":
                            self._after_tool_execution(tool_name, tool_input, result)

                        # Update context
                        error_chain_text = self._get_error_chain_text()
                        context += f"\n\n=== Iteration {iteration}: {tool_name} ===\n{result}"
                        if error_chain_text:
                            context += f"\n\n{error_chain_text}"
                        
                        # Continue to next iteration if all ranges exhausted
                        if self.current_time_range_index >= 6:
                            continue
                
                # If we get here, all ranges are exhausted - allow resolve
                logger.info(f"[ExecuteAgent] RESOLVE ALLOWED - all time ranges exhausted")
                # Calculate confidence based on iterations and tool calls
                confidence = self._calculate_confidence(tool_calls, resolved=True)
                return ExecutionResult(
                    resolved=True,
                    diagnosis=decision.get("diagnosis", "Issue resolved"),
                    solution=decision.get("solution", "No action needed"),
                    tool_calls=tool_calls,
                    final_state="Resolved",
                    confidence=confidence
                )

            if decision.get("action") == "ask_user":
                # BLOCK ask_user until at least 3 tool calls have been made
                if len(tool_calls) < 3:
                    # Force continue instead - bot must investigate more
                    logger.info(f"[ExecuteAgent] Blocking ask_user - only {len(tool_calls)} tool calls made, need at least 3")
                    decision = {
                        "action": "continue",
                        "tool": "search_jaeger_traces",
                        "input": decision.get("input", {})
                    }
                else:
                    return ExecutionResult(
                        resolved=False,
                        diagnosis="Additional information needed",
                        solution="Waiting for user input",
                        questions=[decision.get("question", "Please provide more information")],
                        tool_calls=tool_calls,
                        final_state="Needs user input",
                        confidence=0.5
                    )

            if decision.get("action") == "continue":
                tool_name = decision.get("tool")
                tool_input = decision.get("input", {})
                
                if tool_name == "search_jaeger_traces":
                    # Enforce starting at time_range_index=0
                    tool_input = self._check_and_enforce_time_range(tool_input)
                    logger.info(f"[ExecuteAgent] Executing Jaeger with time_range_index={tool_input.get('time_range_index')}, service={tool_input.get('service')}, tag={tool_input.get('tag_name')}")

                result = await self._execute_tool(tool_name, tool_input, app)

                call_record = ToolCallRecord(
                    tool_name=tool_name,
                    input_params=tool_input,
                    output=result,
                    iteration=iteration,
                    reasoning=decision.get("reasoning", "")
                )
                tool_calls.append(call_record.model_dump())

                should_break_to_new_iteration = False
                if tool_name == "search_jaeger_traces":
                    should_break_to_new_iteration = self._after_tool_execution(tool_name, tool_input, result)
                
                if should_break_to_new_iteration:
                    # Reset for next iteration and break current iteration
                    self.current_time_range_index = 0
                    self.ranges_exhausted = set()
                    logger.info(f"[ExecuteAgent] Breaking to NEW ITERATION - will reset to range 0")
                    break

                if tool_name == "search_jaeger_traces":
                    error_analysis = self._analyze_trace_for_errors(result, iteration)
                    
                    # If root cause found, resolve immediately
                    if error_analysis.get("root_cause_found"):
                        root_cause_entry = next(
                            (e for e in self.error_chain if e.is_root_cause), None
                        )
                        if root_cause_entry:
                            logger.info(f"[ErrorChain] Root cause found: {root_cause_entry.service} - {root_cause_entry.error_message}")
                            return ExecutionResult(
                                resolved=True,
                                diagnosis=f"Root cause: {root_cause_entry.error_message} in {root_cause_entry.service}",
                                solution="Issue identified through trace analysis. Further investigation needed for resolution steps.",
                                tool_calls=tool_calls,
                                final_state="Resolved",
                                confidence=0.9
                            )
                
                # Update context with error chain for LLM visibility
                error_chain_text = self._get_error_chain_text()
                context += f"\n\n=== Iteration {iteration}: {tool_name} ===\n{result}"
                if error_chain_text:
                    context += f"\n\n{error_chain_text}"

        # Max iterations reached - calculate confidence
        confidence = self._calculate_confidence(tool_calls, resolved=False)

        # Fallback to Human: Escalate if confidence < 0.3
        if confidence < 0.3:
            return ExecutionResult(
                resolved=False,
                diagnosis="Investigation incomplete - low confidence",
                solution="BOT unable to resolve - assigning to L2 Engineer",
                tool_calls=tool_calls,
                final_state="Escalated",
                confidence=confidence,
                escalation_reason="Confidence below 0.3 threshold after max iterations"
            )

        # Max iterations reached
        return ExecutionResult(
            resolved=False,
            diagnosis="Investigation incomplete - max iterations reached",
            solution="Manual investigation required",
            tool_calls=tool_calls,
            final_state="Incomplete",
            confidence=confidence
        )

    async def _manage_context(
        self,
        context: str,
        tool_calls: List[Dict]
    ) -> str:
        if not tool_calls:
            return context
        
        # Estimate current token count
        estimated_tokens = estimate_tokens(context)
        
        # If under budget, no compression needed
        if estimated_tokens <= MAX_CONTEXT_TOKENS:
            return context
        
        # Use context compression utility
        from utils.context_compression import summarize_tool_calls
        
        # Compress tool calls section
        recent_calls = tool_calls[-KEEP_RECENT_TOOL_CALLS:]
        older_calls = tool_calls[:-KEEP_RECENT_TOOL_CALLS] if len(tool_calls) > KEEP_RECENT_TOOL_CALLS else []
        
        # Build new tool calls section
        tool_section = "=== RECENT TOOL CALLS (full) ===\n"
        for call in recent_calls:
            tool_name = call.get('tool_name', 'unknown')
            input_params = call.get('input_params', {})
            output = call.get('output', '')[:500]
            tool_section += f"\n- Tool: {tool_name}\n  Input: {input_params}\n  Output: {output}...\n"
        
        if older_calls:
            from utils.context_compression import extract_key_info
            tool_section += "\n=== EARLIER TOOL CALLS (summarized) ===\n"
            for call in older_calls:
                tool_name = call.get('tool_name', 'unknown')
                output = call.get('output', '')
                key_info = extract_key_info(tool_name, output)
                tool_section += f"- {tool_name}: {key_info}\n"
        
        # Replace tool calls section in context
        import re
        tool_calls_pattern = r'=== (PREVIOUS|RECENT|EARLIER) TOOL CALLS ===[\s\S]*?(?==== |\n\n|\Z)'
        new_context = re.sub(tool_calls_pattern, tool_section.strip(), context)
        
        # If still too large, truncate further
        if estimate_tokens(new_context) > MAX_CONTEXT_TOKENS:
            # Keep only last 2 recent calls
            tool_section = "=== TOOL CALLS ===\n"
            for call in tool_calls[-2:]:
                tool_name = call.get('tool_name', 'unknown')
                output = call.get('output', '')[:300]
                tool_section += f"- {tool_name}: {output}...\n"
            new_context = re.sub(tool_calls_pattern, tool_section.strip(), new_context)
        
        return new_context
    
    def _calculate_confidence(
        self,
        tool_calls: List[Dict],
        resolved: bool
    ) -> float:
        if not tool_calls:
            return 0.1
        
        if resolved:
            return min(1.0, 0.5 + (len(tool_calls) * 0.1))
        
        error_count = 0
        for call in tool_calls:
            output = call.get('output', '').lower()
            if 'error' in output or 'failed' in output:
                error_count += 1
        
        error_ratio = error_count / len(tool_calls)
        
        confidence = 1.0 - (error_ratio * 0.5)
        
        if len(tool_calls) < 3:
            confidence *= 0.8
        
        return max(0.1, min(0.9, confidence))
    
    def _build_initial_context(
        self,
        plan_output: PlanOutput,
        incident_description: str,
        app: str,
        customer_identifiers: Dict[str, str],
        problem_category: str
    ) -> str:

        jaeger_data = plan_output.jaeger_results
        if jaeger_data.get("used"):
            jaeger_section = f"""
Jaeger Results (dynamically fetched by Plan Agent):
  - Traces found: {jaeger_data.get('trace_count', 0)}
  - Has errors: {jaeger_data.get('has_errors', False)}
  - Key findings: {jaeger_data.get('raw', 'N/A')[:500]}
"""
        else:
            jaeger_section = "Jaeger Results: Not used by Plan Agent\n"
        
        # Add discovered services to context if available
        services_section = ""
        if self.discovered_services:
            services_section = f"\n=== AVAILABLE JAEGER SERVICES ===\n{self.discovered_services}\n"
        
        context = f"""
=== INCIDENT CONTEXT ===
Application: {app}
Problem Category: {problem_category}

Customer Identifiers:
{chr(10).join(f"  - {k}: {v}" for k, v in customer_identifiers.items()) if customer_identifiers else "  None provided"}
{services_section}
=== PLAN AGENT FINDINGS ===
Issue Identified: {plan_output.issue_identified}
Issue Summary: {plan_output.issue_summary}
{jaeger_section}
=== INCIDENT DESCRIPTION ===
{incident_description}

=== PREVIOUS TOOL CALLS ===
(No tool calls yet)
"""
        return context
    
    async def _decide_next_action(
        self,
        context: str,
        tool_calls: List[Dict],
        iteration: int
    ) -> Dict:
        history_text = ""
        if tool_calls:
            history_text = "\n\n=== PREVIOUS TOOL CALLS ===\n"
            for call in tool_calls:
