                source = hit.get("_source", {})
                output.append(f"\n[Record {idx}]")
                
                # Timestamp
                timestamp = source.get("@timestamp", "N/A")
                output.append(f"Timestamp: {timestamp}")
                
                # Log type
                logtype = source.get("logtype", "N/A")
                output.append(f"Log Type: {logtype}")
                
                # Message (truncate if too long)
                message = source.get("message", "")
                if len(message) > 500:
                    message = message[:500] + "..."
                output.append(f"Message: {message}")
                
                # Extract key fields based on log type
                if logtype == "SMS_logs":
                    # Per SMS SOP section 6.5 - SMS delivery logs
                    if "mobile_number" in source:
                        output.append(f"Mobile Number: {source.get('mobile_number')}")
                    if "status" in source:
                        output.append(f"Delivery Status: {source.get('status')}")
                    if "message_id" in source:
                        output.append(f"Message ID: {source.get('message_id')}")
                    if "transaction_time" in source:
                        output.append(f"Transaction Time: {source.get('transaction_time')}")
                
                elif logtype == "Email_logs":
                    # Per Email SOP section 6.5 - Email delivery logs
                    if "email_address" in source:
                        output.append(f"Email Address: {source.get('email_address')}")
                    if "subject" in source:
                        output.append(f"Subject: {source.get('subject')}")
                    if "status" in source:
                        output.append(f"Delivery Status: {source.get('status')}")
                    if "message_id" in source:
                        output.append(f"Message ID: {source.get('message_id')}")
                
                # Add any error information
                if "error" in source or "error_code" in source:
                    output.append(f"Error: {source.get('error', source.get('error_code', 'Unknown'))}")
                
                output.append("-" * 70)
            
            return "\n".join(output)
            
    except httpx.TimeoutException:
        return "ELK query timed out after 30 seconds. Please try again or reduce the time range."
        
    except httpx.HTTPStatusError as e:
        return f"ELK Query Error (HTTP {e.response.status_code}): {e.response.text}"
        
    except json.JSONDecodeError as e:
        return f"Invalid JSON query: {str(e)}"
        
    except Exception as e:
        return f"Query execution failed: {str(e)}"



