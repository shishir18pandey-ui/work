KEEP_RECENT_TOOL_CALLS = 3

class ExecutionResult(BaseModel):
    resolved: bool = Field(description="Whether the issue was resolved")
    diagnosis: str = Field(description="Root cause of the issue")
    solution: str = Field(description="Steps to resolve")
    questions: List[str] = Field(
        default_factory=list,
        description="Clarification questions if needed"
    )
    tool_calls: List[Dict] = Field(
