    {
      "datasource": { "type": "elasticsearch", "uid": "Elasticsearch-jaeger-spans" },
      "description": "Resolved / Processed. This is auto-resolution rate, NOT semantic accuracy.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 1,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "red" }, { "color": "orange", "value": 20 }, { "color": "green", "value": 50 }]
          },
          "unit": "percent"
        },
        "overrides": []
      },
