          "datasource": { "type": "elasticsearch", "uid": "Elasticsearch-jaeger-spans" },
          "metrics": [{ "id": "1", "type": "count" }],
          "query": "process.serviceName: $servicename AND operationName: \"process_message\"",
          "refId": "A",
          "timeField": "startTimeMillis"
        }
      ],
      "title": "",
      "type": "stat"
    },
