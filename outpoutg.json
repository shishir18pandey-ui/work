        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": [], "fields": "/^C$/", "values": false },
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "11.6.12",
      "targets": [
        {
          "alias": "resolved",
          "bucketAggs": [
            {
              "field": "startTimeMillis",
              "id": "2",
              "settings": { "interval": "1y", "min_doc_count": "0", "trimEdges": 0 },
              "type": "date_histogram"
            }
          ],
          "datasource": { "type": "elasticsearch", "uid": "Elasticsearch-jaeger-spans" },
          "metrics": [{ "id": "1", "type": "count" }],
          "query": "process.serviceName: $servicename AND operationName: \"update_servicenow\" AND tag.resolution_result: \"yes\"",
          "refId": "A",
          "timeField": "startTimeMillis"
        },
        {
          "alias": "processed",
          "bucketAggs": [
            {
              "field": "startTimeMillis",
              "id": "2",
              "settings": { "interval": "1y", "min_doc_count": "0", "trimEdges": 0 },
              "type": "date_histogram"
            }
          ],
          "datasource": { "type": "elasticsearch", "uid": "Elasticsearch-jaeger-spans" },
          "metrics": [{ "id": "1", "type": "count" }],
          "query": "process.serviceName: $servicename AND operationName: \"process_message\"",
          "refId": "B",
          "timeField": "startTimeMillis"
        },
        {
          "datasource": { "name": "Expression", "type": "__expr__", "uid": "__expr__" },
          "expression": "($A/$B)*100",
          "hide": false,
          "refId": "C",
          "type": "math"
        }
      ],
      "title": "Auto-Resolution Rate",
      "type": "stat"
    },
